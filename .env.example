# Modèle factice pour le déploiement / la build d'image.
# Sur le NAS : copier en `.env` et renseigner les vraies valeurs.
# Ne pas committer le `.env` réel (secrets / chemins locaux).

# PDF haute qualité (0/1) — export CLI / plotting
PLOT_ERG_HIGH_QUALITY_PDF=0

# Profiling interne (0/1)
PLOT_ERG_PROFILE=0

# Plateforme Qt (laisser vide en GUI desktop ; "offscreen" en headless/CI)
# QT_QPA_PLATFORM=offscreen
